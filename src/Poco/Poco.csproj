<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\"/>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.2">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <!-- macOS 开发期：把原生 dylib 编进输出目录，让 dotnet run 也能用菜单栏倒计时
         （通知仍需 .app bundle 身份，dylib 内部已守卫）。增量：源文件没变就跳过。 -->
    <Target Name="BuildPocoNativeDylib" AfterTargets="Build"
            Condition="$([MSBuild]::IsOSPlatform('OSX'))"
            Inputs="native/PocoNotify.swift;native/PocoTray.swift"
            Outputs="$(OutDir)libPocoNotify.dylib">
        <Exec Command="swiftc -O -emit-library -o &quot;$(OutDir)libPocoNotify.dylib&quot; native/PocoNotify.swift native/PocoTray.swift -framework UserNotifications -framework AppKit"
              WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>
</Project>
