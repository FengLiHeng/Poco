<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Poco · 番茄钟 组件样式
         双主题颜色走 DynamicResource（随 ThemeVariant 切换）
         阶段语义色走 .focus / .rest 类（随阶段切换） -->

    <!-- 窗口外壳 -->
    <Style Selector="Border.poco-win">
        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
    </Style>

    <!-- 顶栏齿轮 -->
    <Style Selector="Button.gear">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.gear:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BtnBrush}"/>
    </Style>
    <Style Selector="Button.gear:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
    </Style>

    <!-- 阶段标签 -->
    <Style Selector="StackPanel.phase-tag">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.phase-tag > TextBlock.cjk">
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 倒计时 -->
    <Style Selector="StackPanel.countdown">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.countdown > TextBlock">
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="86"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="FontFeatures" Value="+tnum"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style Selector="StackPanel.countdown > TextBlock.sep">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Margin" Value="2,0"/>
    </Style>

    <!-- 已暂停：数字变淡 -->
    <Style Selector="Border.poco-win.paused StackPanel.countdown > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
    </Style>
    <!-- 已结束：数字点亮为当前阶段语义色 -->
    <Style Selector="Border.poco-win.focus.finished StackPanel.countdown > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FocusBrush}"/>
    </Style>
    <Style Selector="Border.poco-win.rest.finished StackPanel.countdown > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource RestBrush}"/>
    </Style>

    <!-- 提示行 -->
    <Style Selector="TextBlock.sub-hint">
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.poco-win.focus TextBlock.sub-hint.accent">
        <Setter Property="Foreground" Value="{DynamicResource FocusInkBrush}"/>
    </Style>
    <Style Selector="Border.poco-win.rest TextBlock.sub-hint.accent">
        <Setter Property="Foreground" Value="{DynamicResource RestInkBrush}"/>
    </Style>

    <!-- 阶段语义色：前景文字 -->
    <Style Selector="Border.poco-win.focus TextBlock.accent-ink">
        <Setter Property="Foreground" Value="{DynamicResource FocusInkBrush}"/>
    </Style>
    <Style Selector="Border.poco-win.rest TextBlock.accent-ink">
        <Setter Property="Foreground" Value="{DynamicResource RestInkBrush}"/>
    </Style>
    <!-- 阶段语义色：填充 -->
    <Style Selector="Border.poco-win.focus Ellipse.accent-fill">
        <Setter Property="Fill" Value="{DynamicResource FocusBrush}"/>
    </Style>
    <Style Selector="Border.poco-win.rest Ellipse.accent-fill">
        <Setter Property="Fill" Value="{DynamicResource RestBrush}"/>
    </Style>

    <!-- 轮次圆点 -->
    <Style Selector="ItemsControl.dots">
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Ellipse.rdot">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
    </Style>
    <Style Selector="Border.poco-win.focus Ellipse.rdot.on">
        <Setter Property="Fill" Value="{DynamicResource FocusBrush}"/>
        <Setter Property="Stroke" Value="{DynamicResource FocusBrush}"/>
    </Style>
    <Style Selector="Border.poco-win.rest Ellipse.rdot.on">
        <Setter Property="Fill" Value="{DynamicResource RestBrush}"/>
        <Setter Property="Stroke" Value="{DynamicResource RestBrush}"/>
    </Style>
    <!-- 当前轮的外圈光晕 -->
    <Style Selector="Ellipse.ring">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Ellipse.ring.show">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.poco-win.focus Ellipse.ring">
        <Setter Property="Fill" Value="{DynamicResource FocusWashBrush}"/>
    </Style>
    <Style Selector="Border.poco-win.rest Ellipse.ring">
        <Setter Property="Fill" Value="{DynamicResource RestWashBrush}"/>
    </Style>

    <!-- 控制区标签 -->
    <Style Selector="TextBlock.ctl-label">
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="LetterSpacing" Value="0.5"/>
        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- 幽灵圆钮（重置 / 跳过） -->
    <Style Selector="Button.btn-ghost">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Background" Value="{DynamicResource BtnBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.btn-ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
    </Style>
    <Style Selector="Button.btn-ghost:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>

    <!-- 主按钮（开始 / 暂停） -->
    <Style Selector="Button.btn-primary">
        <Setter Property="Height" Value="52"/>
        <Setter Property="MinWidth" Value="116"/>
        <Setter Property="Padding" Value="26,0"/>
        <Setter Property="CornerRadius" Value="26"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- 背景填充随阶段语义色；在 hover/pressed 时锁定同色，避免被 Fluent 灰底覆盖 -->
    <Style Selector="Border.poco-win.focus Button.btn-primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FocusBrush}"/>
    </Style>
    <Style Selector="Border.poco-win.rest Button.btn-primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RestBrush}"/>
    </Style>
    <!-- hover / pressed 反馈：整体轻微变化，颜色保持强调色 -->
    <Style Selector="Button.btn-primary:pointerover">
        <Setter Property="Opacity" Value="0.92"/>
    </Style>
    <Style Selector="Button.btn-primary:pressed">
        <Setter Property="Opacity" Value="0.84"/>
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>
    <Style Selector="Button.btn-primary > StackPanel > TextBlock">
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 设置面板 -->
    <Style Selector="TextBlock.set-title">
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="15.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style Selector="TextBlock.set-meta">
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LetterSpacing" Value="0.8"/>
        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
    </Style>
    <Style Selector="Button.set-link">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
    </Style>
    <Style Selector="Button.set-link:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
    </Style>
    <Style Selector="TextBlock.rname">
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.unit">
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
    </Style>
    <Style Selector="Button.step-btn">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource BtnBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.step-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
    </Style>
    <Style Selector="TextBlock.step-val">
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="23"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFeatures" Value="+tnum"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.foot-note">
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LetterSpacing" Value="0.3"/>
        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.reset-default">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusInkBrush}"/>
    </Style>
    <Style Selector="Button.reset-default.quit">
        <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}"/>
    </Style>

    <!-- 主题分段切换 -->
    <Style Selector="Border.segmented">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource BtnBrush}"/>
    </Style>
    <Style Selector="Button.seg">
        <Setter Property="Padding" Value="13,5"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
        <Setter Property="FontFamily" Value="fonts:Poco#HarmonyOS Sans SC"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.seg.active">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.seg.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>

    <!-- ============================================================
         hover / pressed 一致性
         FluentTheme 默认会把按钮文字在悬停/按下时刷成纯黑/纯白，且图标之前不跟随；
         现在图标统一用 {Binding $parent[Button].Foreground} 跟随按钮前景，这里再把各按钮
         hover/pressed 的前景（必要时背景）锁回品牌色板，于是图标与文字一起变化、双主题协调。
         ============================================================ -->
    <Style Selector="Button.gear, Button.btn-ghost, Button.step-btn, Button.seg">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- 主按钮：文字/图标始终 OnAccent -->
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <Style Selector="Button.btn-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>

    <!-- 步进 − + -->
    <Style Selector="Button.step-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style Selector="Button.step-btn:pressed /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
    </Style>

    <!-- 透明文字按钮（返回 / 恢复默认 / 退出）：hover 不出现 Fluent 灰底，前景留在色板 -->
    <Style Selector="Button.set-link:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.reset-default:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource FocusInkBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.reset-default.quit:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- 分段切换：未选中 / 选中 hover 都保持色板色与各自底色 -->
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.seg.active:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>

    <!-- ============================================================
         呼吸动画
         运行中：大号倒计时缓慢呼吸 + 当前轮光晕同步起伏，营造平静的节奏感；
         已结束：倒计时较快脉动以提示该操作了。
         ============================================================ -->
    <Style Selector="Border.poco-win.running StackPanel.countdown">
        <Style.Animations>
            <Animation Duration="0:0:4.5" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.62"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.poco-win.running Ellipse.ring.show">
        <Style.Animations>
            <Animation Duration="0:0:4.5" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.poco-win.finished StackPanel.countdown">
        <Style.Animations>
            <Animation Duration="0:0:1.15" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.42"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
