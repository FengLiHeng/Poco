<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Poco.App"
             xmlns:local="using:Poco"
             RequestedThemeVariant="Light">
    <!-- 默认浅色；可在设置内切换深色（运行时由 MainWindowViewModel.ApplyTheme 按持久化设置覆盖） -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- 字体走内嵌集合（见 PocoFontCollection），XAML 里用 fonts:Poco#族名 引用 -->

            <ResourceDictionary.ThemeDictionaries>
                <!-- ============ 浅色 · 暖奶油纸 ============ -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgBrush" Color="#F7F4EE"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FCF9F5"/>
                    <SolidColorBrush x:Key="RaisedBrush" Color="#F0ECE6"/>
                    <SolidColorBrush x:Key="InkBrush" Color="#39332E"/>
                    <SolidColorBrush x:Key="InkSoftBrush" Color="#6D6661"/>
                    <SolidColorBrush x:Key="InkFaintBrush" Color="#9D9792"/>
                    <SolidColorBrush x:Key="HairlineBrush" Color="#E0DCD7"/>
                    <SolidColorBrush x:Key="BtnBrush" Color="#EAE7E1"/>
                    <SolidColorBrush x:Key="BtnHoverBrush" Color="#E3DFD9"/>
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FBFAF7"/>
                    <SolidColorBrush x:Key="FocusBrush" Color="#B67D61"/>
                    <SolidColorBrush x:Key="FocusInkBrush" Color="#93573B"/>
                    <SolidColorBrush x:Key="FocusWashBrush" Color="#21B67D61"/>
                    <SolidColorBrush x:Key="RestBrush" Color="#619197"/>
                    <SolidColorBrush x:Key="RestInkBrush" Color="#386C76"/>
                    <SolidColorBrush x:Key="RestWashBrush" Color="#24619197"/>
                    <Color x:Key="ShadowColor">#26303030</Color>
                </ResourceDictionary>

                <!-- ============ 深色 · 暖炭灰 ============ -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgBrush" Color="#201D19"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#282420"/>
                    <SolidColorBrush x:Key="RaisedBrush" Color="#322D28"/>
                    <SolidColorBrush x:Key="InkBrush" Color="#E4DFD8"/>
                    <SolidColorBrush x:Key="InkSoftBrush" Color="#A39D97"/>
                    <SolidColorBrush x:Key="InkFaintBrush" Color="#6D6862"/>
                    <SolidColorBrush x:Key="HairlineBrush" Color="#3D3834"/>
                    <SolidColorBrush x:Key="BtnBrush" Color="#37322D"/>
                    <SolidColorBrush x:Key="BtnHoverBrush" Color="#423C37"/>
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A1612"/>
                    <SolidColorBrush x:Key="FocusBrush" Color="#D49371"/>
                    <SolidColorBrush x:Key="FocusInkBrush" Color="#E3A480"/>
                    <SolidColorBrush x:Key="FocusWashBrush" Color="#2ED49371"/>
                    <SolidColorBrush x:Key="RestBrush" Color="#7DB5B9"/>
                    <SolidColorBrush x:Key="RestInkBrush" Color="#8BC3C8"/>
                    <SolidColorBrush x:Key="RestWashBrush" Color="#2E7DB5B9"/>
                    <Color x:Key="ShadowColor">#73000000</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Poco/Styles/Poco.axaml"/>
    </Application.Styles>
</Application>
